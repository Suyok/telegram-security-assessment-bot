# Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Your Telegram Bot Token
# Get it from @BotFather on Telegram: /newbot
BOT_TOKEN=your_bot_token_here

# OPTIONAL: Admin User ID (for /addtarget, /removetarget, /targets commands)
# Get your ID using @userinfobot or check logs when you /start
ADMIN_ID=your_telegram_user_id_here

# OPTIONAL: Environment mode
NODE_ENV=production

# OPTIONAL: Log level (for future enhancements)
LOG_LEVEL=info